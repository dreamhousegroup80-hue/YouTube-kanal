# ── Inbound auth (optional but recommended) ──────────────────────────────────
# If set, the /render endpoint requires:  Authorization: Bearer <RENDER_TOKEN>
# Put the same value in the n8n "Call Railway FFmpeg" node (see README).
RENDER_TOKEN=change-me-to-a-long-random-string

# No Google credentials are needed. n8n lists the Drive folder itself and passes
# PUBLIC download links in the /render request; this service just downloads them.
# The Drive working folder must be shared as "Anyone with the link -> Viewer".

# Railway sets PORT automatically; only needed for local runs.
PORT=8080
